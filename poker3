        for i in active_players:
            score, tie_breaker, hand_name = evaluate_hand(hands[i])
            print(f"{label_names[i]} -> {hands[i]} ({hand_name})")
            evaluated_players.append((score, tie_breaker, i))
            
        best_hand = max(evaluated_players, key=lambda x: (x[0], x[1]))
