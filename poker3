                        print("X Error: Please do not enter duplicate positions.")
                        continue
                    break
                except ValueError:
                    print("X Error: Invalid input. Please enter numbers separated by spaces.")
            
            if to_discard:
                for pos in sorted(to_discard, reverse=True):
                    hands[0].pop(pos)
                while len(hands[0]) < 5:
                    hands[0].append(deck.pop())
                print(f"Your new hand: {hands[0]}")
            else:
                print("You decided to keep all your cards.")
                
        for i in list(active_players):
            if i == 0:
                continue
            comp_discard_indices = computer_discard_decision(hands[i], max_discards)
            if comp_discard_indices:
                for pos in sorted(comp_discard_indices, reverse=True):
                    hands[i].pop(pos)
                while len(hands[i]) < 5:
                    hands[i].append(deck.pop())
                print(f"🤖 {label_names[i]} discarded {len(comp_discard_indices)} card{'s' if len(comp_discard_indices) > 1 else ''}.")
            else:
                print(f"🤖 {label_names[i]} decided to keep all its cards.")

        print(f"\n--- ROUND {round_num} BETTING PHASE ---")
        # 🌟 Pass master_investments into the function here
        round_pot = run_betting_round(hands, chips, active_players, label_names, master_investments)
