# --- RUN BETTING ROUND ---
def run_betting_round(hands, chips, active_players, label_names, master_investments):
    """
    Handles a structured round of betting where active players can check, call, raise, or fold.
    """
    current_bet = 0
    investments = {i: 0 for i in active_players}
    settled = {i: False for i in active_players}
    
    while not all(settled[p] for p in active_players) and len(active_players) > 1:
        for i in list(active_players):
            if len(active_players) <= 1 or settled[i]:
                continue
                
            call_amount = current_bet - investments[i]
            
            # --- HUMAN PLAYER TURN ---
            if i == 0:
                print(f"\n--- YOUR TURN TO BET ---")
                print(f"Current Pot addition needed to stay in: {call_amount} chips (Total Bet this round: {current_bet})")
                print(f"Your remaining chips: {chips[0]}")
                
                while True:
                    options = ["fold"]
                    if call_amount == 0:
                        options.append("check")
                    if call_amount > 0 and chips[0] >= call_amount:
                        options.append("call")
                    if chips[0] > call_amount:
                        options.append("raise")
                        
                    choice = input(f"Choose an action ({', '.join(options)}): ").strip().lower()
                    
                    if choice not in options:
                        print("X Invalid option. Try again.")
                        continue
                        
                    if choice == "fold":
                        active_players.remove(0)
                        print("You folded your hand.")
                        break
                    elif choice == "check":
                        settled[0] = True
                        print("You checked.")
                        break
                    elif choice == "call":
                        chips[0] -= call_amount
                        investments[0] += call_amount
                        master_investments[0] += call_amount # Track globally
                        settled[0] = True
                        print(f"You called {call_amount} chips.")
                        break
                    elif choice == "raise":
                        try:
                            raise_amt = int(input(f"How much extra would you like to raise by? (1-{chips[0] - call_amount}): "))
                            if 1 <= raise_amt <= (chips[0] - call_amount):
                                total_put_in = call_amount + raise_amt
                                chips[0] -= total_put_in
                                investments[0] += total_put_in
                                master_investments[0] += total_put_in # Track globally
                                current_bet = investments[0]
                                
                                for p in active_players:
                                    settled[p] = (p == 0)
                                print(f"You raised the bet by {raise_amt}. Total round bet is now {current_bet}.")
                                break
                            else:
                                print("X Invalid chip amount.")
                        except ValueError:
                            print("X Please enter a valid number.")
                            
            # --- COMPUTER PLAYER TURN ---
            else:
                if chips[i] == 0:
                    settled[i] = True
                    continue
                    
                # Calculate what they've invested total up to this exact moment
                current_total_investment = master_investments[i] + investments[i]
                
                # Pass the master investment into the decision
                action, amount = computer_betting_decision(hands[i], current_bet, investments[i], chips[i], current_total_investment)
                
                if action == "fold":
                    active_players.remove(i)
                    print(f"🤖 {label_names[i]} folded.")
                elif action == "check":
                    settled[i] = True
                    print(f"🤖 {label_names[i]} checked.")
                elif action == "call":
                    chips[i] -= amount
                    investments[i] += amount
                    master_investments[i] += amount # Track globally
                    settled[i] = True
                    print(f"🤖 {label_names[i]} called {amount} chips.")
                elif action == "raise":
                    chips[i] -= amount
                    investments[i] += amount
                    master_investments[i] += amount # Track globally
                    current_bet = investments[i]
                    for p in active_players:
                        settled[p] = (p == i)
                    print(f"🤖 {label_names[i]} raised! They added {amount} chips. Total round bet is now {current_bet}.")

    return sum(investments.values())




