    active_players = list(range(num_players))
    pot = 0
    
    master_investments = {i: 0 for i in range(num_players)}
    
    # --- BLINDS PHASE ---
    print("\n--- FORCED BLINDS ---")
    sb_amount = min(chips[0], 1)
    chips[0] -= sb_amount
    pot += sb_amount
    master_investments[0] += sb_amount # 🌟 Track it
    print(f"You posted Small Blind: {sb_amount} chip.")
    
    bb_amount = min(chips[1], 2)
    chips[1] -= bb_amount
    pot += bb_amount
    master_investments[1] += bb_amount # 🌟 Track it
    print(f"{label_names[1]} posted Big Blind: {bb_amount} chips.")
    print(f"Total starting Pot: {pot} chips.")

    rounds = [(1, 3), (2, 2), (3, 1)]
    
    for round_num, max_discards in rounds:
        if len(active_players) <= 1:
            break
            
        print(f"\n--- ROUND {round_num} (Discard up to {max_discards} card{'s' if max_discards > 1 else ''}) ---")
        
        if 0 in active_players:
            print(f"Your current hand: {hands[0]}")
            
            while True:
                try:
                    print("Select cards to discard by typing their positions (1 to 5), separated by spaces.")
                    print("Press Enter to keep all cards.")
                    user_input = input("Positions to discard: ").strip()
                    
                    if not user_input:
                        to_discard = []
                        break
                        
                    to_discard = [int(x) - 1 for x in user_input.split()]
                    
                    if len(to_discard) > max_discards:
                        print(f"X Error: You can only discard a maximum of {max_discards} cards this round.")
                        continue
                    if any(pos < 0 or pos > 4 for pos in to_discard):
                        print("X Error: Card positions must be between 1 and 5.")
                        continue
