    # 9. One Pair
    if mc[0][1] + wild_count >= 2:
        pair_val = mc[0][0] if mc else 12
        remaining = [v for v in natural_values if v != pair_val]
        # Dynamically calculate precise kickers without duplicate ghost values
        while len(remaining) < 3:
            next_fill = 12
            while next_fill in remaining or next_fill == pair_val or next_fill == 0:
                next_fill -= 1
            remaining.append(next_fill)
        return (1, [pair_val, remaining[0], remaining[1], remaining[2]], "Pair")

    # 10. High Card
    padded_values = list(natural_values)
    next_card = 12
    while len(padded_values) < 5:
        if next_card not in padded_values and next_card != 0: # Avoid deuce value slots
