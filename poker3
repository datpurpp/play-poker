# --- AI DISCARD LOGIC ---
def computer_discard_decision(hand, max_discards, is_deuces_wild=False):
    """
    Simple AI: Holds onto pairs or better. If it has nothing,
    it keeps its highest cards and discards the lowest up to the limit.
    In Deuces Wild mode, it NEVER discards a wild 2.
    """
    # Use the appropriate evaluator based on the active game mode
    score, values, hand_name = evaluate_wild_hand(hand) if is_deuces_wild else evaluate_hand(hand)
    counts = Counter([card.value for card in hand])
    
    # If AI has a straight, flush, full house, or better, don't change anything!
    if score >= 4:
        return []
        
    discard_indices = []
    
    # If AI has Three of a Kind, Two Pair, or One Pair, keep matching cards, discard kickers
    if score in [1, 2, 3]:
        for i, card in enumerate(hand):
            # In wild mode, protect any '2' from being discarded as a kicker
            if is_deuces_wild and card.rank == '2':
                continue
            if counts[card.value] == 1: # It's a single kicker card
                discard_indices.append(i)
    else:
        # High card setup: Discard the lowest cards up to the limit, protecting 2s
        # Sort cards by value lowest to highest
        sorted_indices = sorted(range(len(hand)), key=lambda k: hand[k].value)
        for idx in sorted_indices:
            if is_deuces_wild and hand[idx].rank == '2':
                continue # Skip discarding if it's a wild card
            discard_indices.append(idx)
        
    # Strictly respect the round constraint limit
    return discard_indices[:max_discards]


