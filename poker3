            else:
                print(f"👑 {label_names[win_idx].upper()} WINS! Better hand combination: {hand_name}!")
            print(f"Claimed the entire pot of {pot} chips.")
        else:
            winner_labels = [label_names[w[2]] for w in winners]
            split_pot = pot // len(winners)
            print(f"🤝 IT'S A DRAW BETWEEN: {', '.join(winner_labels)}!!")
            print(f"The pot of {pot} chips is split evenly ({split_pot} chips each).")
        print("="*45)

